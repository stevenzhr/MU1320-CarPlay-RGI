#!/bin/sh
# All actions are logged on SD. Rollback is also available via control.sh
# if the card cannot be remounted; that recovery entry writes no SD logs.
set -eu
for var in LD_PRELOAD LD_DEBUG DL_DEBUG LD_DEBUG_OUTPUT; do unset "$var" || :; done
PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin:/mnt/app/armle/bin:/mnt/app/armle/usr/bin
export PATH
case "$*: $#" in 'status: 1'|'install: 1'|'rollback: 1'|'collect before: 2'|'collect marked: 2'|'collect restored: 2'|'collect snapshot: 2') ;; *) echo 'usage: preload_probe.sh status|install|rollback|collect before|marked|restored|snapshot'; exit 2 ;; esac
case "$0" in */*) stage_dir=${0%/*} ;; *) exit 2 ;; esac
stage_dir=$(CDPATH= cd "$stage_dir" && pwd -P)
case "$stage_dir" in /fs/sda0/*) sd=/fs/sda0 ;; /fs/sdb0/*) sd=/fs/sdb0 ;; *) echo 'STOP: use SD /fs/sda0 or /fs/sdb0'; exit 2 ;; esac
fail() { echo "STOP: $*" >&2; exit 1; }
uid=$(id -u)
set -f
# Tokenize QNX's whitespace-padded UID without changing the action arguments.
(set -- $uid; [ "$#" = 1 ] && [ "$1" = 0 ]) || fail 'effective UID must be 0'
case "$(uname -a)" in QNX\ *\ 6.5.0\ *\ armle) ;; *) fail 'wrong platform' ;; esac
check() {
    [ -f "$3" ] && [ ! -L "$3" ] || return 1
    c=$1; n=$2; output=$(cksum "$3") || return 1; set -- $output
    [ "${1:-}" = "$c" ] && [ "${2:-}" = "$n" ]
}
check @MOUNT_CRC@ @MOUNT_SIZE@ "$stage_dir/mount_state" || fail 'mount helper checksum'
check @CONTROL_CRC@ @CONTROL_SIZE@ "$stage_dir/control.sh" || fail 'control checksum'
check 3727885851 560715 /proc/boot/libc.so.3 || fail 'libc baseline'
state() { (LD_LIBRARY_PATH=/proc/boot:/lib exec "$stage_dir/mount_state" "$sd"); }
initial=$(state) || fail 'SD mount query'
case "$initial" in ro|rw) ;; *) fail 'unknown SD mount state' ;; esac
restore=0; log=''; completed=0
cleanup() {
    rc=$?; trap - 0 1 2 15; set +e
    sync || rc=1
    if [ "$restore" = 1 ]; then mount -ur "$sd" || rc=1; fi
    final=$(state); query=$?
    if [ "$query" != 0 ] || [ "$final" != "$initial" ]; then
        echo "STOP: SD state not restored to $initial; do not remove card" >&2; rc=1
    else echo "SD_MOUNT_RESTORED: $sd=$final"; fi
    [ -z "$log" ] || echo "ACTION_LOG_ON_SD: $log"
    if [ "$rc" = 0 ] && [ "$completed" = 1 ]; then echo 'PRELOAD_PROBE_ACTION_PASSED'; fi
    exit "$rc"
}
trap cleanup 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15
if [ "$initial" = ro ]; then restore=1; mount -uw "$sd"; fi
[ "$(state)" = rw ] || fail 'SD not writable'
umask 077
out="$stage_dir/out"
[ ! -L "$out" ] || fail 'unsafe out directory'
if [ ! -d "$out" ]; then mkdir "$out"; fi
log="$out/action-$1-$$.txt"
[ ! -e "$log" ] && [ ! -L "$log" ] || fail 'action log collision'
set +e
(set -C; /bin/sh "$stage_dir/control.sh" "$@" > "$log" 2>&1)
rc=$?
set -e
cat "$log"
[ "$rc" = 0 ] || exit "$rc"
completed=1
