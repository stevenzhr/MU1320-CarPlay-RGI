#!/bin/sh
# SD logging/mount wrapper. Direct control.sh rollback remains available when
# removable-media logging itself is unavailable.
set -eu
for var in LD_PRELOAD LD_DEBUG DL_DEBUG LD_DEBUG_OUTPUT; do unset "$var" || :; done
PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin:/mnt/app/armle/bin:/mnt/app/armle/usr/bin
export PATH
case "$*: $#" in
  'status: 1'|'install: 1'|'arm: 1'|'disarm: 1'|'rollback: 1'|'collect armed: 2'|'collect restored: 2'|'collect snapshot: 2') ;;
  *) echo 'usage: navhook_trial.sh status|install|arm|disarm|rollback|collect armed|restored|snapshot'; exit 2 ;;
esac
requested_action=$1
requested_phase=${2:-}
case "$0" in */*) stage_dir=${0%/*} ;; *) exit 2 ;; esac
stage_dir=$(CDPATH= cd "$stage_dir" && pwd -P)
case "$stage_dir" in /fs/sda0/*) sd=/fs/sda0 ;; /fs/sdb0/*) sd=/fs/sdb0 ;; *) echo 'STOP: use SD /fs/sda0 or /fs/sdb0'; exit 2 ;; esac
fail() { echo "STOP: $*" >&2; exit 1; }
uid=$(id -u); set -f
(set -- $uid; [ "$#" = 1 ] && [ "$1" = 0 ]) || fail 'effective UID must be 0'
case "$(uname -a)" in QNX\ *\ 6.5.0\ *\ armle) ;; *) fail 'wrong platform' ;; esac
# Compare the two pinned cksum fields explicitly.  This wrapper deliberately
# avoids a helper that reuses positional parameters under the old QNX shell.
output=$(cksum "$stage_dir/mount_state"); set -- $output
[ "${1:-}" = '@MOUNT_CRC@' ] && [ "${2:-}" = '@MOUNT_SIZE@' ] || fail 'mount helper checksum'
output=$(cksum "$stage_dir/control.sh"); set -- $output
[ "${1:-}" = '@CONTROL_CRC@' ] && [ "${2:-}" = '@CONTROL_SIZE@' ] || fail 'control checksum'
state() { (LD_LIBRARY_PATH=/proc/boot:/lib exec "$stage_dir/mount_state" "$sd"); }
initial=$(state) || fail 'SD mount query'
case "$initial" in ro|rw) ;; *) fail 'unknown SD mount state' ;; esac
restore=0; log=''; completed=0
cleanup() {
    rc=$?; trap - 0 1 2 15; set +e
    sync || rc=1
    if [ "$restore" = 1 ]; then mount -ur "$sd" || rc=1; fi
    final=$(state); query=$?
    if [ "$query" != 0 ] || [ "$final" != "$initial" ]; then
        echo "STOP: SD state not restored to $initial; do not remove card" >&2; rc=1
    else echo "SD_MOUNT_RESTORED: $sd=$final"; fi
    [ -z "$log" ] || echo "ACTION_LOG_ON_SD: $log"
    if [ "$rc" = 0 ] && [ "$completed" = 1 ]; then echo 'NAVHOOK_TRIAL_ACTION_PASSED'; fi
    exit "$rc"
}
trap cleanup 0
trap 'exit 129' 1; trap 'exit 130' 2; trap 'exit 143' 15
if [ "$initial" = ro ]; then restore=1; mount -uw "$sd" || fail 'SD remount rw'; fi
[ "$(state)" = rw ] || fail 'SD not writable'
umask 077; out="$stage_dir/out"
[ ! -L "$out" ] || fail 'unsafe out directory'
[ -d "$out" ] || mkdir "$out"
log="$out/action-$requested_action-$$.txt"
[ ! -e "$log" ] && [ ! -L "$log" ] || fail 'action log collision'
set +e
if [ -n "$requested_phase" ]; then
    (set -C; /bin/sh "$stage_dir/control.sh" "$requested_action" "$requested_phase" > "$log" 2>&1)
else
    (set -C; /bin/sh "$stage_dir/control.sh" "$requested_action" > "$log" 2>&1)
fi
rc=$?
set -e
cat "$log"
[ "$rc" = 0 ] || exit "$rc"
completed=1
