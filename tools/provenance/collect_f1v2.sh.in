#!/bin/sh
set -eu
for var in LD_PRELOAD LD_DEBUG DL_DEBUG LD_DEBUG_OUTPUT; do unset "$var" || :; done
PATH=/proc/boot:/bin:/usr/bin:/sbin:/usr/sbin:/mnt/app/armle/bin:/mnt/app/armle/usr/bin
export PATH
phase=${1:-snapshot}; case "$phase" in f1|restored|snapshot) ;; *) exit 2 ;; esac
JARS=/mnt/app/eso/hmi/lsd/jars
ROOT=@RUNTIME_ROOT@
SYSTEM=/mnt/system/etc/eso/production/smartphone_integrator.json; ACTIVE=/etc/eso/production/smartphone_integrator.json
for utility in pidin mkdir cat cksum sync cp grep uname date find; do command -v "$utility" >/dev/null 2>&1 || { echo "STOP: missing $utility"; exit 2; }; done
case "$0" in */*) sd_dir=${0%/*} ;; *) exit 2 ;; esac
sd_dir=$(CDPATH= cd "$sd_dir" && pwd -P); case "$sd_dir" in /fs/sda0/*|/fs/sdb0/*) ;; *) echo 'STOP: collector must run from SD'; exit 2 ;; esac
umask 077; out="$sd_dir/out"; [ -d "$out" ] || mkdir "$out"; [ ! -L "$out" ] || exit 2
logdir="$out/$phase-$$"; mkdir "$logdir"
collect() {
    echo "F1_COLLECT_BEGIN version=@VERSION@ phase=$phase"; uname -a; date
    echo CONFIG_CHECKSUMS; cksum "$SYSTEM" "$ACTIVE" /etc/eso/production/dio_manager.json /mnt/system/etc/eso/production/dio_manager.json
    echo HMI_ARCHIVES_BEGIN; find "$JARS" \( -name '*.jar' -o -name '*.zip' \) -exec cksum {} \; ; echo HMI_ARCHIVES_END
    echo WORKSPACE_BEGIN; find "$ROOT" -type f -exec cksum {} \; 2>&1 || :; cat "$ROOT/phase.txt" 2>&1 || :; echo WORKSPACE_END
    # Witnesses live in RAM: present means no full restart since that action.
    echo RAM_WITNESSES
    for f in /tmp/mu1320-f1-@VERSION@.install-witness /tmp/mu1320-f1-@VERSION@.rollback-witness /tmp/mu1320-navhook-v1.arm /tmp/carplay_verbose /tmp/carplay_java.log /tmp/carplay_hook.log /tmp/mu1320-f1-naviseam.log; do
        if [ -e "$f" ] || [ -L "$f" ]; then echo "PRESENT: $f"; else echo "ABSENT: $f"; fi
    done
    pidin -F '%a %e %256n' > "$logdir/processes.txt" 2>&1; src=$?; echo "PROCESS_TABLE_BEGIN exit=$src"; cat "$logdir/processes.txt"; echo PROCESS_TABLE_END; [ "$src" = 0 ] || return 1
    hmi=0; dio=0
    while read -r p parent name rest; do
        case "$p" in ''|*[!0-9]*) continue;; esac
        case "$name" in
            */j9|j9) hmi=$((hmi+1)); echo "HMI_J9 pid=$p parent=$parent" ;;
            */smartphone_integrator|smartphone_integrator) echo "SI pid=$p parent=$parent" ;;
            */dio_manager|dio_manager)
                dio=$((dio+1)); envfile="$logdir/DIO-$p-environment.txt"; pidin -p "$p" environment > "$envfile" 2>&1; erc=$?
                preload=0; grep 'LD_PRELOAD=' "$envfile" >/dev/null 2>&1 && preload=1 || :
                echo "DIO pid=$p parent=$parent env_exit=$erc DIO_ENV_PRELOAD=$preload" ;;
        esac
    done < "$logdir/processes.txt"
    echo "HMI_J9_PROCESSES=$hmi"; echo "DIO_PROCESSES_OBSERVED=$dio"
    # Full system log goes to SD only; the terminal gets a bounded Java/terminal-mode excerpt.
    if command -v sloginfo >/dev/null 2>&1; then sloginfo > "$logdir/sloginfo.txt" 2>&1; lrc=$?; else echo 'sloginfo unavailable' > "$logdir/sloginfo.txt"; lrc=127; fi
    echo "SLOGINFO_SAVED exit=$lrc lines=$(grep -c '' "$logdir/sloginfo.txt" 2>/dev/null || :)"
    grep -i -E 'exception|verifyerror|linkageerror|noclassdef|classformat|incompatibleclass|j9vm|terminalmode|carplay|smartphone' "$logdir/sloginfo.txt" > "$logdir/sloginfo-java-excerpt.txt" 2>/dev/null || :
    echo "SLOG_EXCERPT_BEGIN lines=$(grep -c '' "$logdir/sloginfo-java-excerpt.txt" 2>/dev/null || :)"
    n=0; while IFS= read -r line && [ "$n" -lt 150 ]; do printf '%s\n' "$line"; n=$((n+1)); done < "$logdir/sloginfo-java-excerpt.txt"
    echo SLOG_EXCERPT_END
    echo JAVACORE_SEARCH_BEGIN
    for d in /tmp /mnt/app/eso/hmi /mnt/app/eso/hmi/lsd /ifs/jre /mnt/app/root; do
        [ -d "$d" ] || continue; find "$d" \( -name 'javacore*' -o -name 'Snap*.trc' -o -name 'jitdump*' -o -name 'core.*.dmp' \) -print 2>/dev/null || :
    done > "$logdir/javacore-list.txt" 2>&1
    cat "$logdir/javacore-list.txt"
    while IFS= read -r f; do case "$f" in */javacore*) [ -f "$f" ] && cp "$f" "$logdir/" 2>/dev/null || : ;; esac; done < "$logdir/javacore-list.txt"
    echo JAVACORE_SEARCH_END
    echo 'INTERPRETATION: f1 needs no install witness, new HMI_J9 pid, F1 archive and no NavActiveIgnore in HMI_ARCHIVES, a working Audi smartphone/CarPlay session and the manual NAVI/phone/Siri observations; restored needs baseline archives after a new boot'
    echo "F1_COLLECT_END phase=$phase"
}
set +e; collect > "$logdir/collect.txt" 2>&1; rc=$?; set -e
cat "$logdir/collect.txt"; echo "COLLECT_EXIT=$rc"; sync || echo 'WARNING: sync failed'; echo "SAVED_ON_SD: $logdir"; exit "$rc"
